# --- 100% Free AI Provider API Keys (Set at least one) ---
# Primary (Recommended): OpenRouter Free Tier (Llama 3.3, Gemma 4, DeepSeek :free models)
# Generate free key at: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY="sk-or-your_openrouter_free_key_here"

# Fallback 1: Hugging Face Serverless Inference API
# Generate free token at: https://huggingface.co/settings/tokens
HF_TOKEN="hf_your_huggingface_token_here"

# Fallback 2: Ollama Cloud
OLLAMA_API_KEY="your_ollama_cloud_api_key_here"

# (Optional) Override primary provider priority: openrouter | huggingface | ollama
DEFAULT_AI_PROVIDER="openrouter"

# Target URL for frontend to communicate with AI Chat backend
VITE_AI_BACKEND_URL="https://your_vercel_app.vercel.app/api/chat"

# (Optional) Upstash Redis / Vercel KV credentials for Edge rate limiting
KV_REST_API_URL="your_kv_rest_api_url_here"
KV_REST_API_TOKEN="your_kv_rest_api_token_here"

